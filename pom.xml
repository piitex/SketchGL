<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.piitex</groupId>
    <artifactId>SketchGL</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <rengl.version>0.1.1</rengl.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- The RenGL engine, which SketchGL is built with (from Maven Central). -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>RenGL</artifactId>
            <version>${rengl.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- RenGL's native libraries (Skia, plus LWJGL's natives through its pom) come in a rengl-natives-<platform> artifact for each platform. The profile for the
         computer building the project switches on by itself. -->
    <profiles>
        <profile>
            <id>rengl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-macos-arm64</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-macos</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-windows</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-windows-arm64</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-linux</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rengl-natives-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.github.piitex</groupId>
                    <artifactId>rengl-natives-linux-arm64</artifactId>
                    <version>${rengl.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
